# QRaksha Web — Staging Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key

# Staging Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=https://qraksha-api-staging.onrender.com/api/v1

# Sentry Monitoring & Tracing
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=staging
