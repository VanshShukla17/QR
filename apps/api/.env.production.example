# QRaksha API — Production (Pilot) Environment Variables
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://qraksha.vercel.app

# Supabase Production Project
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-supabase-service-role-key

# Google Gemini API (Production Key)
GEMINI_API_KEY=your-production-gemini-api-key

# Blockchain EVM Testnet (Polygon Amoy — Dedicated Monitored Production Pilot Wallet)
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_PRIVATE_KEY=your-production-pilot-wallet-private-key
CHAIN_NETWORK=amoy

# Sentry Monitoring & Tracing
SENTRY_DSN=https://your-sentry-dsn@o0000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
