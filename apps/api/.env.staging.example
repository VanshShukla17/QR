# QRaksha API — Staging Environment Variables
PORT=4000
NODE_ENV=staging
CORS_ORIGIN=https://staging.qraksha.vercel.app,http://localhost:3000,http://localhost:3001

# Supabase Staging Project (Isolated from Production)
SUPABASE_URL=https://staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key

# Google Gemini API (Staging Key)
GEMINI_API_KEY=your-staging-gemini-api-key

# Blockchain EVM Testnet (Polygon Amoy — Dedicated Staging Wallet)
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_PRIVATE_KEY=your-staging-wallet-private-key
CHAIN_NETWORK=amoy

# Sentry Monitoring & Tracing
SENTRY_DSN=https://your-sentry-dsn@o0000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=staging
