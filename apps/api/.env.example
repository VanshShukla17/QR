# apps/api .env.example - QRaksha Express Backend API

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase (Postgres & Storage) Service Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (AI Agent Pipeline)
GEMINI_API_KEY=your-gemini-api-key

# Blockchain Credential Anchoring (EVM Testnet)
CHAIN_NETWORK=polygon-amoy
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_PRIVATE_KEY=your-server-custodial-wallet-private-key
