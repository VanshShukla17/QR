# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Postgres & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Blockchain EVM Testnet (Polygon Amoy / Sepolia)
CHAIN_RPC_URL=https://polygon-amoy.drpc.org
CHAIN_PRIVATE_KEY=your-testnet-wallet-private-key
CHAIN_NETWORK=amoy

# Sarvam AI Voice Assistant (Bulbul TTS & Transliteration)
SARVAM_API_KEY=your-sarvam-subscription-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh

