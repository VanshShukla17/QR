{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/__tests__/**/*",
    "src/scripts/benchmark-performance.ts",
    "src/scripts/rehearse-rollback.ts"
  ],
  "references": [{ "path": "../../packages/shared" }]
}
